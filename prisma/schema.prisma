model Salesperson {
  id        String   @id
  code      String   @unique
  name      String
  branch    String?
  status    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
}

// Product / operating-company master (Informix ps_company).
// coCode '02'=CP, '03'/'15'=LHC, 20/24/25/26=external exchange partners.
// Deliberately has NO relations — Agreement/AmcSchedule/Resort keep plain coCode
// strings; deleteProduct guards referential integrity in the controller instead.
model Product {
  id            String   @id
  coCode        String   @unique
  coName        String
  entType       String // W=Week, P=Points
  add1          String?
  add2          String?
  add3          String?
  telNo         String?
  faxNo         String?
  contactPerson String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
}

// Leisure Vacation Club exchange-programme master (Informix lvc_master).
// An LVC code names an exchange arrangement between products (LVC-CP: 03/15 <-> 02)
// or with an external partner (LVC-SGI, LVC-CLC, ...).
model LvcCode {
  id        String   @id
  lvcCode   String   @unique // lvc_code, e.g. 'LVC-CP'
  coCode    String? // lvc_cocode -> Product.coCode (ps_company.psc_cocode); validated, no hard FK
  lvcName   String
  status    String   @default("A") // A=Active, U=Inactive
  incoming  Int      @default(0) // running counters owned by the exchange process --
  outgoing  Int      @default(0) // imported so no data is lost, but never written by
  faxBatch  Int      @default(0) // the CRUD and not shown on screen
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
}

model Resort {
  id               String    @id
  resortCode       String    @unique
  coCode           String
  shortName        String?
  resortName       String
  rciCode          String?
  rciAffiliate     String?
  lockOnOff        String?
  resortMgmt       String?
  contactPerson    String?
  add1             String?
  add2             String?
  add3             String?
  city             String?
  state            String?
  country          String?
  telNo            String?
  faxNo            String?
  checkInTime      String?
  checkOutTime     String?
  status           String    @default("A")
  paymt            String?
  lockStatus       String?
  legacyCreateUser String?
  legacyCreateDate DateTime?
  legacyModUser    String?
  legacyModDate    DateTime?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @db.Timestamptz(3)
  infoLines        ResortInfoLine[]
  apartmentTypes   ApartmentType[]
  units            ResortUnit[]
  aptBlocks        AptBlock[]
  resAvail         ResAvailMast[]
  maintenance      ResortMaintenance[]
  seasonPoints     SeasonPoint[]
}

model ResortInfoLine {
  id        String             @id
  resortId  String
  resort    Resort             @relation(fields: [resortId], references: [id], onDelete: Cascade)
  category  ResortInfoCategory
  seq       Int
  text      String
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  @@unique([resortId, category, seq])
}

model ApartmentType {
  id            String   @id
  resortId      String
  resort        Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  resortCode    String   // denormalized natural key (Resort.resortCode is unique + immutable)
  apartmentType String
  description   String?
  lockType      String   @default("LN") // LM=Master Unit, LS=Split Unit, LN=Normal Unit
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  @@unique([resortCode, apartmentType])
}

model ResortUnit {
  id            String   @id
  resortId      String
  resort        Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  resortCode    String   // denormalized natural key
  unitNo        String   // apt_code — e.g. "3227/3228", "1.12A"
  apartmentType String   // apt_unit_type — validated against ApartmentType (no hard FK; type is renamable)
  occupancy     Int?     // apt_occupancy
  rciReserved   String   @default("N") // apt_rci_reserved Y/N
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  @@unique([resortCode, unitNo])
}

// Units Availability Setup by Dates — the input record (apt_block.txt).
// One row per (resort, unit, date-range) block. Staff CRUD this; each save
// expands into per-day ResAvailMast rows. Post-go-live re-import clobbers CRUD edits.
model AptBlock {
  id            String   @id
  resortId      String
  resort        Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  resortCode    String   // denormalized natural key
  unitNo        String   // apt_code — incl. compound lock-off codes like "3005/3006"
  apartmentType String?  // derived from ResortUnit at CRUD time; null for migrated rows whose unit isn't in apt_mast
  startDate     DateTime // UTC midnight (business date)
  endDate       DateTime // UTC midnight (business date)
  blockNo       Int?     // col[4] per-unit running block number (migrated only)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  @@unique([resortCode, unitNo, startDate, endDate])
}

// Units Availability Setup by Dates — the generated per-day grid (res_avail_mast.txt).
// Keyed by (resort, apartment type, date). actNight = count of units of that type
// registered for that day; balNight = act minus maintenance minus bookings.
// relNight/lockStatus not migrated.
model ResAvailMast {
  id            String   @id
  resortId      String
  resort        Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  resortCode    String
  apartmentType String
  date          DateTime // UTC midnight (business date)
  actNight      Int
  balNight      Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  @@unique([resortCode, apartmentType, date])
}

// Resorts Maintenance (resmt.txt) — a unit withdrawn from the booking pool for
// housekeeping / buffer / repair over a date range. Each save decrements the
// generated ResAvailMast grid's balNight for the unit's apartment type
// (actNight untouched — the unit still exists, it just isn't bookable).
// The migration does NOT apply those deltas: res_avail_mast.txt was exported
// with maintenance already deducted from ram_bal_night.
model ResortMaintenance {
  id            String   @id
  resortId      String
  resort        Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  resortCode    String   // denormalized natural key
  unitNo        String   // rm_apt_code — incl. compound lock-off codes like "3231/3232"
  apartmentType String?  // derived from ResortUnit at CRUD time; null for rows whose unit isn't in the apt_mast export
  startDate     DateTime // rm_checkin  — UTC midnight (business date)
  endDate       DateTime // rm_checkout — UTC midnight (business date)
  remarks       String?  // rm_remarks — reason (BUFFER / HOUSEKEEPING / UPGRADING / ...)
  serialNo      Int?     // rm_serial_no (migrated only)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  @@unique([resortCode, unitNo, startDate])
}

// Holidays (Resorts Setup fn 7) — one business-supplied national calendar covering BOTH
// public holidays (single dates) and school breaks (date ranges), discriminated by
// holidayType. No Informix source. Global: nationwide, not per-resort or per-state.
// Cloned forward a year at a time (same month/day) and then corrected by staff, since
// lunar/Islamic holidays and school terms both shift annually.
//
// holidayType is a plain String validated by z.enum in the controller, NOT a Prisma enum
// — adding a kind later must not require a migration (same reasoning as CpSeasonDate.season).
model Holiday {
  id          String    @id
  holidayType String    // 'PUBLIC' | 'SCHOOL'
  startDate   DateTime  // UTC midnight (business date). PUBLIC: the holiday date itself.
  endDate     DateTime? // null for PUBLIC (single day); required for SCHOOL
  year        Int       // PUBLIC: derived server-side from startDate. SCHOOL: the academic year, editable.
  description String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @db.Timestamptz(3)
  // Looser than the old SchoolHoliday key [academicYear, description] — "one TERM 1 per
  // academic year" is re-enforced in the controller (descriptionTaken), because a year-scoped
  // unique would wrongly block multi-day public holidays that repeat a name on other dates.
  @@unique([holidayType, startDate, description])
  @@index([holidayType, year])
}

// CP Season calendar (Resorts Setup fn 8) — from Informix ps_seasondate.txt.
// One row per calendar day, graded G/S/D; drives CP points pricing per night.
// Global: the source has no resort column.
// PRODUCT SCOPE: this is the ONLY holiday/peak calendar CP booking reads.
// Holiday (public + school) is LHC-only — never join or derive across them.
model CpSeasonDate {
  id        String   @id
  date      DateTime @unique // UTC midnight (business date) — one season per day
  season    String   // G=Gold, S=Silver, D=Diamond
  year      Int      // derived server-side from date; drives the filter + clone
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  @@index([year])
}

// Season Points (Resorts Setup fn 9) — ONE chart for the points deducted per night, by
// resort x apartment type x season x day of week, discriminated by pointsType:
//   HOME — the member's own product's resort (coCode '02', CP-PBR today), from Informix
//          ps_seasonapt.txt. CpSeasonDate (fn 8) grades the day G/S/D; this table turns
//          that grade into a number. Only the first 12 source cols are imported —
//          pssa_lvcpts0..6 are zero on every row.
//   AWAY — every other resort (our own LHC resorts and the partner/exchange V-* codes),
//          reached through an LVC exchange programme, from Informix ps_lvcapt.txt (first
//          14 of 20 cols). This is why pssa_lvcpts0..6 are zero in ps_seasonapt: the away
//          points lived in their own Informix table.
// The weekly total shown on screen is derived (sum of the 7 days), never stored.
//
// pointsType is a plain String validated by z.enum in the controller, NOT a Prisma enum
// (same reasoning as Holiday.holidayType and CpSeasonDate.season), and is DERIVED
// server-side from the resort's coCode on every save — never taken from the payload.
model SeasonPoint {
  id            String   @id
  pointsType    String   // 'HOME' | 'AWAY'
  resortId      String
  resort        Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  resortCode    String   // denormalized natural key — the resort being booked
  coCode        String   // the resort's OWN product, denormalized from Resort
  lvcCoCode     String?  // AWAY only — the product whose members are charged; null for HOME
  apartmentType String   // validated against ApartmentType on save; stored pairs grandfathered
  effectiveDate DateTime // UTC midnight (business date) — the VERSION this row belongs to
  season        String   // G=Gold, S=Silver, D=Diamond
  ptsSun        Int      // source col 0 — Sunday
  ptsMon        Int
  ptsTue        Int
  ptsWed        Int
  ptsThu        Int
  ptsFri        Int
  ptsSat        Int      // source col 6 — Saturday
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  // A points chart is an effective-dated VERSION: all rows sharing (resortCode,
  // effectiveDate) are one chart, which stays in force until a later version supersedes
  // it. A new version is created only when a rate changes or a room type is introduced —
  // NOT annually. There is exactly ONE effective date per resort per version.
  //
  // RESOLUTION RULE for booking: the chart in force for a stay date D is the version with
  // the greatest effectiveDate <= D for that resort. There is no end date and no `year`.
  //
  // pointsType is deliberately NOT in the key: a resort is either home or away, so
  // resortCode already determines it. lvcCoCode is a version-level attribute, written
  // uniformly across the version's rows.
  //
  // map: is required — the generated name would exceed PostgreSQL's 63-char limit.
  @@unique([resortCode, effectiveDate, apartmentType, season], map: "SeasonPoint_natkey_key")
  @@index([resortCode, effectiveDate])
}

model SuReason {
  code        String      @id
  description String
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  agreements  Agreement[]
}

model State {
  code String @id
  name String
}

model User {
  id             Int                @id @default(autoincrement())
  fullName       String
  username       String             @unique
  email          String             @unique
  phone          String?
  passwordHash   String
  mustChangePwd  Boolean            @default(true)
  status         UserStatus         @default(ACTIVE)
  departmentId   Int
  lastLoginAt    DateTime? @db.Timestamptz(3)
  failedAttempts Int                @default(0)
  lockedAt       DateTime? @db.Timestamptz(3)
  sessionToken   String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @db.Timestamptz(3)
  auditLogs      AuditLog[]
  department     Department         @relation(fields: [departmentId], references: [id])
  reportAccess   UserReportAccess[] @relation("userReports")
  grantedReports UserReportAccess[] @relation("grantedReports")
}

model UserReportAccess {
  id          Int       @id @default(autoincrement())
  userId      Int
  reportKey   ReportKey
  grantedById Int
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @db.Timestamptz(3)
  user        User      @relation("userReports", fields: [userId], references: [id])
  grantedBy   User      @relation("grantedReports", fields: [grantedById], references: [id])

  @@unique([userId, reportKey])
}

