generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agreement {
  id                     String              @id
  agreementNo            String
  legacyAgreementNo      String?
  memberId               String
  membershipNo           String
  agreementDate          DateTime
  endDate                DateTime?
  termYears              Int
  coCode                 String
  entitlementType        EntitlementType
  agreementType          String?
  memberType             String?
  totalPoints            Int?
  acctClassify           AgreementStatus     @default(NA)
  acctStatus             String?
  purchasePrice          Decimal?            @db.Decimal(12, 2)
  downPayment            Decimal?            @db.Decimal(12, 2)
  subFees                Decimal?            @db.Decimal(12, 2)
  loanAmount             Decimal?            @db.Decimal(12, 2)
  loanType               String?
  salesBranch            String?
  salesMonth             String?
  salesSource            String?
  certificateNo          String?
  transferFlag           String?
  transferToMembership   String?
  transferFromMembership String?
  canCode                String?
  rciRefNo               String?
  rciEnrolDate           DateTime?
  rciExpiryDate          DateTime?
  rciFeePaid             Decimal?            @db.Decimal(12, 2)
  outstdDoc              Boolean             @default(false)
  docDescription         String?
  legacyCreatedAt        DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime
  govtTax                Decimal?            @db.Decimal(12, 2)
  legacyModifiedAt       DateTime?
  statusChangeDate       DateTime?
  statusChangeUser       String?
  sinkFund               Decimal?            @db.Decimal(12, 2)
  cancellationReason     CancellationReason? @relation(fields: [canCode], references: [code])
  member                 Member              @relation(fields: [memberId], references: [id])
  amcInvoices            AmcInvoice[]
  amcSchedule            AmcSchedule?
  nominees               Nominee[]
  pbsScheme              PbsScheme?
}

model AmcInvoice {
  id              String       @id
  scheduleId      String
  agreementId     String
  membershipNo    String
  agreementNo     String
  docNo           String?
  invNo           String
  invComponent    InvComponent
  invDate         DateTime
  amcDate         DateTime?
  dueDate         DateTime?
  invoiceYearSeq  Int?
  invAmount       Decimal      @db.Decimal(12, 2)
  totalPoints     Int?
  rate            Decimal?     @db.Decimal(8, 4)
  amountInWords   String?
  billType        BillType
  coCode          String
  isProcessed     Boolean      @default(false)
  processedAt     DateTime?
  printDate       DateTime?
  printUser       String?
  printCount      Int          @default(0)
  newFlag         String?
  legacyCreatedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  agreement       Agreement    @relation(fields: [agreementId], references: [id])
  schedule        AmcSchedule  @relation(fields: [scheduleId], references: [id])
}

model AmcPrice {
  id            String   @id
  coCode        String
  effectiveDate DateTime
  priceCode     String
  currencyCode  String?
  amcAmount     Decimal  @db.Decimal(12, 2)
  sinkingFund   Decimal  @db.Decimal(12, 2)
  serviceTax    Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  amountInWords String?
  rate          Decimal  @default(1) @db.Decimal(8, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  isActive      Boolean  @default(true)

  @@unique([coCode, priceCode, effectiveDate])
}

model AmcPricePoints {
  id              String   @id
  coCode          String   @default("02")
  effectiveDate   DateTime
  minPoints       Int
  maxPoints       Int
  amcRatePerPoint Decimal  @db.Decimal(8, 4)
  sinkingFundPct  Decimal  @db.Decimal(6, 2)
  gstPct          Decimal  @db.Decimal(6, 2)
  unitPrice       Decimal? @db.Decimal(12, 2)
  rciPoints       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  isActive        Boolean  @default(true)

  @@unique([coCode, minPoints, maxPoints, effectiveDate])
}

model AmcSchedule {
  id              String        @id
  agreementId     String        @unique
  membershipNo    String
  agreementNo     String
  coCode          String
  firstDueDate    DateTime?
  nextDueDate     DateTime?
  lastInvoiceDate DateTime?
  invoicesIssued  Int           @default(0)
  totalInvoices   Int
  priceCode       String?
  billingStatus   BillingStatus @default(N)
  legacyCreatedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  invoices        AmcInvoice[]
  agreement       Agreement     @relation(fields: [agreementId], references: [id])
}

model AuditLog {
  id         Int             @id @default(autoincrement())
  userId     Int
  action     String
  actionType AuditActionType
  targetType String?
  targetId   Int?
  metadata   Json?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id])
}

model CancellationReason {
  code        String      @id
  description String
  category    String
  type        String?
  status      String      @default("A")
  createdAt   DateTime    @default(now())
  agreements  Agreement[]
}

model Department {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique
  description String?
  isLocked    Boolean                @default(false)
  createdAt   DateTime               @default(now())
  permissions DeptModulePermission[]
  users       User[]
}

model DeptModulePermission {
  id           Int        @id @default(autoincrement())
  departmentId Int
  module       AppModule
  canView      Boolean    @default(false)
  canCreate    Boolean    @default(false)
  canEdit      Boolean    @default(false)
  canDelete    Boolean    @default(false)
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, module])
}

model Member {
  id                String       @id
  membershipNo      String       @unique
  memberType        MemberType
  branchCode        String?
  accpacRef         String?
  subsCategory      String?
  fullName          String
  salutation        String?
  nameCard          String?
  icOld             String?
  icNew             String?
  nationality       String?
  dateOfBirth       DateTime?
  gender            String?
  race              String?
  maritalStatus     String?
  email             String?
  telHome           String?
  telMobile         String?
  resAdd1           String?
  resAdd2           String?
  resAdd3           String?
  resCityState      String?
  resPostcode       String?
  resStateCode      String?
  mailAdd1          String?
  mailAdd2          String?
  mailAdd3          String?
  mailCityState     String?
  mailPostcode      String?
  mailStateCode     String?
  workNature        String?
  companyName       String?
  compAdd1          String?
  compAdd2          String?
  compAdd3          String?
  compCityState     String?
  compPostcode      String?
  compStateCode     String?
  telOffice         String?
  designation       String?
  spouseName        String?
  spouseIc          String?
  jaName            String?
  jaIc              String?
  jaIcNew           String?
  jaSalutation      String?
  jaDesignation     String?
  jaNameCard        String?
  jaAdd1            String?
  jaAdd2            String?
  jaAdd3            String?
  jaCity            String?
  jaPostcode        String?
  jaState           String?
  jaTelHome         String?
  jaTelOffice       String?
  jaMobile          String?
  jaEmail           String?
  registrationNo    String?
  incorporationDate DateTime?
  businessNature    String?
  tinNumber         String?      @db.VarChar(15)
  enrolRci          Boolean      @default(false)
  activeHcm         Boolean      @default(false)
  remarks           String?
  status            MemberStatus @default(ACTIVE)
  legacyCreatedAt   DateTime?
  legacyModifiedAt  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  faxNo             String?
  faxOffice         String?
  telOffice2        String?
  agreements        Agreement[]
}

model Nominee {
  id          String    @id
  agreementId String
  nomineeSeq  Int
  fullName    String?
  icOld       String?
  icNew       String?
  salutation  String?
  designation String?
  nameCard    String?
  telHome     String?
  telMobile   String?
  add1        String?
  add2        String?
  add3        String?
  cityState   String?
  postcode    String?
  email       String?
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  @@unique([agreementId, nomineeSeq])
}

model PbsScheme {
  id          String    @id
  agreementId String    @unique
  coCode      String
  agreementNo String
  certNo      String?
  schemeType  String?
  paybackDate DateTime?
  topUp       Boolean   @default(false)
  pbsIndc     Boolean   @default(false)
  claimIndc   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  agreement   Agreement @relation(fields: [agreementId], references: [id])
}

model State {
  code String @id
  name String
}

model User {
  id             Int                @id @default(autoincrement())
  fullName       String
  username       String             @unique
  email          String             @unique
  phone          String?
  passwordHash   String
  mustChangePwd  Boolean            @default(true)
  status         UserStatus         @default(ACTIVE)
  departmentId   Int
  lastLoginAt    DateTime?
  failedAttempts Int                @default(0)
  lockedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime
  auditLogs      AuditLog[]
  department     Department         @relation(fields: [departmentId], references: [id])
  reportAccess   UserReportAccess[] @relation("userReports")
  grantedReports UserReportAccess[] @relation("grantedReports")
}

model UserReportAccess {
  id          Int       @id @default(autoincrement())
  userId      Int
  reportKey   ReportKey
  grantedById Int
  grantedAt   DateTime  @default(now())
  updatedAt   DateTime
  user        User      @relation("userReports", fields: [userId], references: [id])
  grantedBy   User      @relation("grantedReports", fields: [grantedById], references: [id])

  @@unique([userId, reportKey])
}

enum AgreementStatus {
  NA
  SU
  PT
  TM
}

enum AppModule {
  ADMIN
  MEMBERS
  AGREEMENTS
  AMC_BILLING
  RESORT_BOOKING
  ENTITLEMENTS
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  SUSPEND
}

enum BillType {
  N
  A
  H
  F
}

enum ReportKey {
  MEMBER_REPORT
  AGREEMENT_REPORT
  EXPIRY_REPORT
}

enum BillingStatus {
  N
  C
}

enum EntitlementType {
  W
  P
}

enum InvComponent {
  MAIN_AMC
  SINKING_FUND
  SERVICE_TAX
  ROUNDING
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  DECEASED
  TRANSFERRED
}

enum MemberType {
  INDIVIDUAL
  CORPORATE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
