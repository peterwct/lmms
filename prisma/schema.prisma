generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agreement {
  id                     String              @id
  agreementNo            String
  legacyAgreementNo      String?
  memberId               String
  membershipNo           String
  agreementDate          DateTime
  endDate                DateTime?
  termYears              Int
  coCode                 String
  entitlementType        EntitlementType
  agreementType          String?
  memberType             String?
  totalPoints            Int?
  acctClassify           AgreementStatus     @default(NA)
  acctStatus             String?
  purchasePrice          Decimal?            @db.Decimal(12, 2)
  downPayment            Decimal?            @db.Decimal(12, 2)
  subFees                Decimal?            @db.Decimal(12, 2)
  loanAmount             Decimal?            @db.Decimal(12, 2)
  loanType               String?
  salesBranch            String?
  salesMonth             String?
  salesSource            String?
  certificateNo          String?
  transferFlag           String?
  transferToMembership   String?
  transferFromMembership String?
  transferDate           DateTime?
  transferToDate         DateTime?
  transferUser           String?
  transferToUser         String?
  canCode                String?
  suCode                 String?
  rciRefNo               String?
  rciNominee             String?
  rciEnrolDate           DateTime?
  rciExpiryDate          DateTime?
  rciFeePaid             Decimal?            @db.Decimal(12, 2)
  outstdDoc              Boolean             @default(false)
  docDescription         String?
  legacyCreatedAt        DateTime?
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @db.Timestamptz(3)
  govtTax                Decimal?            @db.Decimal(12, 2)
  legacyModifiedAt       DateTime?
  statusChangeDate       DateTime? @db.Timestamptz(3)
  statusChangeUser       String?
  sinkFund               Decimal?            @db.Decimal(12, 2)
  salespersonCode        String?
  cancellationReason     CancellationReason? @relation(fields: [canCode], references: [code])
  suReason               SuReason?           @relation(fields: [suCode], references: [code])
  member                 Member              @relation(fields: [memberId], references: [id])
  amcInvoices            AmcInvoice[]
  amcSchedule            AmcSchedule?
  bookingEntitlements    BookingEntitlement[]
  nominees               Nominee[]
  pbsScheme              PbsScheme?
}

model BookingEntitlement {
  id           String    @id
  agreementId  String
  coCode       String
  agreementNo  String
  membershipNo String
  yearSeq      Int
  nightsUsed   Int       @default(0)
  actualNights Int       @default(0)
  weekendUsed  Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @db.Timestamptz(3)
  agreement    Agreement @relation(fields: [agreementId], references: [id])

  @@unique([coCode, agreementNo, membershipNo, yearSeq])
  @@index([coCode, agreementNo, membershipNo])
}

model CpBookingEntitlement {
  id           String   @id
  agreementId  String?
  coCode       String
  membershipNo String
  agreementNo  String
  useYear      DateTime
  totalPts     Int      @default(0)
  curUsePts    Int      @default(0)
  advUsePts    Int      @default(0)
  acrusePts    Int      @default(0)
  balPts       Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @db.Timestamptz(3)
  @@unique([coCode, membershipNo, agreementNo, useYear])
  @@index([coCode, membershipNo, agreementNo])
}

model AmcInvoice {
  id              String       @id
  scheduleId      String
  agreementId     String
  membershipNo    String
  agreementNo     String
  docNo           String?
  invNo           String
  invComponent    InvComponent
  invDate         DateTime
  amcDate         DateTime?
  dueDate         DateTime?
  invoiceYearSeq  Int?
  invAmount       Decimal      @db.Decimal(12, 2)
  totalPoints     Int?
  rate            Decimal?     @db.Decimal(8, 4)
  amountInWords   String?
  billType        BillType
  coCode          String
  isProcessed     Boolean      @default(false)
  processedAt     DateTime? @db.Timestamptz(3)
  prevNextDueDate     DateTime? // schedule.nextDueDate before this invoice advanced it (for exact cancel rollback)
  prevLastInvoiceDate DateTime? // schedule.lastInvoiceDate before this invoice advanced it
  printDate       DateTime? @db.Timestamptz(3)
  printUser       String?
  printCount      Int          @default(0)
  newFlag         String?
  legacyCreatedAt DateTime?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @db.Timestamptz(3)
  agreement       Agreement    @relation(fields: [agreementId], references: [id])
  schedule        AmcSchedule  @relation(fields: [scheduleId], references: [id])
}

// Persistent per-coCode AMC invoice running number. Seeded from Informix
// ctrl_billtab.last_amcinv (03/15/02) so the new system continues numbering
// where Informix left off. Advanced on generation, reversed on cancellation
// (only when the cancelled invoice holds the current last number).
model AmcInvoiceCounter {
  coCode    String   @id          // "02", "03", "15"
  lastInvNo Int                    // last used AMC invoice running number
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
}

model AmcPrice {
  id            String   @id
  coCode        String
  effectiveDate DateTime
  priceCode     String
  currencyCode  String?
  amcAmount     Decimal  @db.Decimal(12, 2)
  sinkingFund   Decimal  @db.Decimal(12, 2)
  serviceTax    Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  amountInWords String?
  rate          Decimal  @default(1) @db.Decimal(8, 4)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  isActive      Boolean  @default(true)

  @@unique([coCode, priceCode, effectiveDate])
}

model AmcPricePoints {
  id              String   @id
  coCode          String   @default("02")
  effectiveDate   DateTime
  minPoints       Int
  maxPoints       Int
  amcRatePerPoint Decimal  @db.Decimal(8, 4)
  sinkingFundPct  Decimal  @db.Decimal(6, 2)
  gstPct          Decimal  @db.Decimal(6, 2)
  unitPrice       Decimal? @db.Decimal(12, 2)
  rciPoints       Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @db.Timestamptz(3)
  isActive        Boolean  @default(true)

  @@unique([coCode, minPoints, maxPoints, effectiveDate])
}

model AmcSchedule {
  id              String        @id
  agreementId     String        @unique
  membershipNo    String
  agreementNo     String
  coCode          String
  firstDueDate    DateTime?
  nextDueDate     DateTime?
  lastInvoiceDate DateTime?
  invoicesIssued  Int           @default(0)
  totalInvoices   Int
  priceCode       String?
  billingStatus   BillingStatus @default(N)
  legacyCreatedAt DateTime?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @db.Timestamptz(3)
  invoices        AmcInvoice[]
  agreement       Agreement     @relation(fields: [agreementId], references: [id])
}

model AuditLog {
  id         Int             @id @default(autoincrement())
  userId     Int
  action     String
  actionType AuditActionType
  targetType String?
  targetId   Int?
  metadata   Json?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  user       User            @relation(fields: [userId], references: [id])
}

model CancellationReason {
  code        String      @id
  description String
  category    String
  type        String?
  status      String      @default("A")
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  agreements  Agreement[]
}

model Department {
  id          Int                    @id @default(autoincrement())
  name        String                 @unique
  description String?
  isLocked    Boolean                @default(false)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  permissions DeptModulePermission[]
  users       User[]
}

model DeptModulePermission {
  id           Int        @id @default(autoincrement())
  departmentId Int
  module       AppModule
  canView      Boolean    @default(false)
  canCreate    Boolean    @default(false)
  canEdit      Boolean    @default(false)
  canDelete    Boolean    @default(false)
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, module])
}

